{
  "name": "japanese-decision-model-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:jev": "bun run src/runner.ts --adapter jev --dataset datasets/japanese-decision-v1",
    "bench:clef": "bun run src/runner.ts --adapter clef --dataset datasets/japanese-decision-v1",
    "bench:clef-flash": "bun run src/runner.ts --adapter clef-flash --dataset datasets/japanese-decision-v1",
    "bench:openai": "bun run src/runner.ts --adapter openai-decisions --dataset datasets/japanese-decision-v1",
    "report": "bun run src/report.ts",
    "check": "bun run src/check-dataset.ts datasets/japanese-decision-v1",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
